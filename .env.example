# Copy to $PIPELINE_HOME/.env (default ~/.job-pipeline/.env). Never commit the real file.

# IMAP mailbox that receives the job-list email, ATS verification codes and confirmations.
# For Gmail use an app-specific secret (Google account > Security > App passwords).
MAIL_ADDRESS=
MAIL_APP_PW=

# Credentials used when an ATS (Workday, Oracle, iCIMS...) requires creating an account.
# Use a unique value; it is read by workday.js and never printed.
ATS_DEFAULT_EMAIL=
ATS_DEFAULT_PW=
# Per-tenant override for an account created earlier with different credentials:
# ATS_EXAMPLECO_PW=

# Optional: shell command that receives operator notifications on stdin
# (e.g. a script that posts to a Slack/Discord webhook). Empty = print to stderr.
NOTIFY_CMD=

# Optional runtime switches
# PIPELINE_PACE=1          human-like pacing for form fills (see README)
# AGENT_BROWSER=agent-browser
# PIPELINE_CHROME_BIN=/path/to/Chrome
